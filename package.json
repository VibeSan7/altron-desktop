{
  "name": "altron-desktop",
  "version": "0.5.0-beta.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild altron/ui/main.mjs --bundle --format=esm --platform=browser --target=chrome130 --external:react --external:@hermes/plugin-sdk --outfile=altron/desktop/plugin.js && esbuild altron/bootstrap/main.mjs --bundle --format=esm --platform=browser --target=chrome130 --external:react --external:@hermes/plugin-sdk --outfile=altron/bootstrap/plugin.js",
    "test": "node --test altron/tests/desktop.test.mjs altron/tests/team.test.mjs altron/tests/view.test.mjs altron/tests/workspace-tools.test.mjs altron/tests/task-controls.test.mjs altron/tests/mission-view.test.mjs",
    "test:native": "node --test altron/tests/native.test.mjs",
    "test:autonomous": "node --test altron/tests/autonomous-native.test.mjs",
    "test:upgrade": "node --test altron/tests/upgrade.test.mjs",
    "test:live": "node --test altron/tests/live.test.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  }
}
